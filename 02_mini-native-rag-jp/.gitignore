# ===== 密钥与环境变量（根目录 .gitignore 已覆盖 .env） =====
.env
*.env
!.env.example

# ===== Python =====
__pycache__/
*.py[cod]
*.so
.venv/
venv/
*.egg-info/

# ===== 本地缓存（HF 模型、pip、临时目录都指向这里，见 setup.ps1） =====
.cache/
.tmp/
.piptmp/
*.lock.txt

# ===== 运行产物：向量索引、原始语料、日志 =====
index/
data/raw/
logs/
*.log

# ===== 文档生成物备份 =====
.backup/
